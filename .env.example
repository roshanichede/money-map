# MoneyMap settings. Copy to .env (same folder) and fill in what you need.
# ./start.sh reads this file and passes it to both the API and the website.

# ---- Sign-in ----
# Email + password sign-in is always on. ./start.sh fills in AUTH_SECRET and INTERNAL_API_SECRET for you.
# Optional: add a Google OAuth client (README → "Add Google sign-in") to show "Continue with Google" too.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
INTERNAL_API_SECRET=

# ---- Chat wording by Claude (optional) ----
# Without a key the chat still answers, using the calculated figures directly.
ANTHROPIC_API_KEY=
# MONEYMAP_MODEL=claude-haiku-5-5

# ---- Advanced ----
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/moneymap
# API_URL=http://localhost:8000
